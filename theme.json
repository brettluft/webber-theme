{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "background",
          "color": "#111111",
          "name": "Dark Background"
        },
        {
          "slug": "foreground",
          "color": "#eeeeee",
          "name": "Light Text"
        },
        {
          "slug": "primary",
          "color": "#00ffcc",
          "name": "Futuristic Cyan"
        },
        {
          "slug": "secondary",
          "color": "#1a1a1a",
          "name": "Darker Panel"
        }
      ],
      "duotone": []
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
          "slug": "system-font",
          "name": "System Font"
        },
        {
          "fontFamily": "'Courier New', Courier, monospace",
          "slug": "monospace",
          "name": "Monospace"
        }
      ],
      "fluid": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-font)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontWeight": "800",
          "letterSpacing": "-0.02em"
        }
      },
      "h2": {
        "typography": {
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#111111"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--monospace)",
          "fontWeight": "bold"
        },
        "border": {
          "radius": "4px"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--monospace)",
          "fontWeight": "bold",
          "fontSize": "1.5rem"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "core/group": {
        "spacing": {
          "padding": {
            "top": "2rem",
            "bottom": "2rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        }
      },
      "core/navigation": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--monospace)",
          "fontWeight": "bold"
        },
        "css": ".wp-block-navigation__responsive-container.is-menu-open { padding: 2rem; }"
      }
    }
  }
}
